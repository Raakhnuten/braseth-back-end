# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.prod.example .env    # fill in every value; never commit .env
# Generate secrets with: openssl rand -hex 32

# Image tag to run: "latest", or a commit SHA to pin/roll back.
API_TAG=latest

DB_NAME=braseth_ecommerce
DB_USERNAME=braseth_ecommerce
DB_PASSWORD=

JWT_SECRET=

# Gmail account + app password for verification / reset e-mails.
MAIL_USERNAME=
MAIL_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Where browsers reach MinIO, e.g. https://files.braseth.com
MINIO_PUBLIC_URL=

# The public web app, e.g. https://braseth.com
FRONTEND_URL=
# Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Staff Telegram alerts for new quote requests (optional; empty = off).
# Bot token from @BotFather; chat id of the admin, or of a staff group the bot is in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google reCAPTCHA v2 secret key for customer sign-in and sign-up (optional;
# empty = check off). Pairs with recaptchaSiteKey in the web app.
RECAPTCHA_SECRET=
