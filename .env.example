# Copy to .env (never commit .env) or set these in your IDE run config / host.
# Values shown are the local docker-compose defaults unless marked required.

DB_HOST=localhost
DB_PORT=5445
DB_NAME=braseth_ecommerce
DB_USERNAME=braseth_ecommerce
DB_PASSWORD=braseth_ecommerce

# Required outside the "local" profile. Generate with: openssl rand -hex 32
JWT_SECRET=

# Gmail account + app password used for verification / reset e-mails.
MAIL_USERNAME=
MAIL_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Staff Telegram alerts for new quote requests (optional; empty = off).
# Bot token from @BotFather; chat id of the admin, or of a staff group the bot is in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google reCAPTCHA v2 secret key for customer sign-in and sign-up (optional;
# empty = check off). Pairs with recaptchaSiteKey in the web app.
RECAPTCHA_SECRET=
